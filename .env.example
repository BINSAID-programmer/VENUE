# VENUE — Environment Configuration (Stage 9B Security Hardened)
# ============================================================================
# SECURITY WARNING:
# 1. NEVER prefix server-side secrets (such as GEMINI_API_KEY, Firebase Admin
#    Service Account keys, or private tokens) with VITE_. Any variable prefixed
#    with VITE_ is bundled into the public frontend JavaScript.
# 2. Keep GEMINI_API_KEY strictly server-side (read only by server.ts).
# ============================================================================

# Gemini API Key (Server-side only — used by /api/tutor/chat in server.ts)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application Base URL
APP_URL="MY_APP_URL"

